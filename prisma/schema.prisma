generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Configuracion {
  id        Int      @id @default(autoincrement())
  whatsapp  String   @default("+54 342 4 537262")
  updatedAt DateTime @updatedAt
}

model Doctor {
  id             Int                  @id @default(autoincrement())
  nombre         String
  foto           String?
  texto          String?
  activo         Boolean              @default(true)
  orden          Int                  @default(0)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  especialidades DoctorEspecialidad[]
  sedes          DoctorSede[]
}

model Especialidad {
  id       Int                  @id @default(autoincrement())
  nombre   String               @unique
  doctores DoctorEspecialidad[]
}

model Sede {
  id       Int          @id @default(autoincrement())
  nombre   String       @unique
  doctores DoctorSede[]
}

model DoctorEspecialidad {
  doctorId       Int
  especialidadId Int
  doctor         Doctor       @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  especialidad   Especialidad @relation(fields: [especialidadId], references: [id])

  @@id([doctorId, especialidadId])
}

model DoctorSede {
  doctorId Int
  sedeId   Int
  doctor   Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  sede     Sede   @relation(fields: [sedeId], references: [id])

  @@id([doctorId, sedeId])
}

model CategoriaNoticia {
  id        Int       @id @default(autoincrement())
  nombre    String    @unique
  slug      String    @unique
  color     String    @default("#00b3a4")
  novedades Novedad[]
}

model Novedad {
  id              Int               @id @default(autoincrement())
  titulo          String
  slug            String            @unique
  contenido       String
  imagenDestacada String?
  publicado       Boolean           @default(false)
  destacada       Boolean           @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  categoriaId     Int?
  categoria       CategoriaNoticia? @relation(fields: [categoriaId], references: [id])
}

// Pop-up del home (un único registro). `version` sube con cada guardado,
// así "una vez por IP" vuelve a mostrarse cuando se edita el contenido.
model Popup {
  id         Int          @id @default(autoincrement())
  titulo     String       @default("")
  contenido  String       @default("")
  activo     Boolean      @default(false)
  frecuencia String       @default("UNA_VEZ") // UNA_VEZ (por IP) | SIEMPRE (cada ingreso)
  version    Int          @default(1)
  updatedAt  DateTime     @updatedAt
  vistas     PopupVista[]
}

model PopupVista {
  id        Int      @id @default(autoincrement())
  popupId   Int
  version   Int
  ipHash    String
  createdAt DateTime @default(now())
  popup     Popup    @relation(fields: [popupId], references: [id], onDelete: Cascade)

  @@unique([popupId, version, ipHash])
}

// Una fila por página vista. No se guarda la IP, solo un hash.
model Visita {
  id          Int      @id @default(autoincrement())
  createdAt   DateTime @default(now())
  path        String
  visitorId   String // id anónimo persistente del navegador
  sessionId   String // id anónimo de la sesión (pestaña)
  ipHash      String
  referrer    String?
  refHost     String?
  fuente      String // DIRECTO | BUSCADOR | SOCIAL | REFERIDO | CAMPANIA
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  pais        String?
  region      String?
  ciudad      String?
  dispositivo String // MOBILE | TABLET | DESKTOP
  navegador   String
  sistema     String
  idioma      String?

  @@index([createdAt])
  @@index([path, createdAt])
  @@index([sessionId])
  @@index([visitorId])
}
